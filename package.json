{
  "name": "arca-sdks",
  "private": true,
  "description": "Monorepo de los SDKs de TypeScript para los web services de ARCA (ex AFIP)",
  "type": "module",
  "workspaces": [
    "packages/common",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs --all && npm run build --workspaces",
    "clean": "node scripts/clean-dist.mjs --all",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:pkg": "npm run lint:pkg --workspaces",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "test:smoke": "node scripts/smoke-require.cjs",
    "wsdl:check": "node scripts/wsdl.mjs",
    "api:check": "node scripts/api-report.mjs",
    "api:update": "node scripts/api-report.mjs --write",
    "wsdl:update": "node scripts/wsdl.mjs --write",
    "typecheck:examples": "for p in packages/*/examples; do tsc -p $p || exit 1; done",
    "test:coverage": "vitest run --project unit --coverage",
    "check:snippets": "node scripts/check-snippets.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@microsoft/api-extractor": "^7.60.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "publint": "^0.3.25",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@microsoft/api-extractor": {
      "minimatch": "^11.0.1"
    }
  }
}
