{
  "name": "@ramiidv/arca-common",
  "version": "0.4.0",
  "description": "Utilidades compartidas para los SDKs de ARCA (ex AFIP) - WSAA, SOAP client, validadores, tipos comunes",
  "author": "ramiidv",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only"
  },
  "keywords": [
    "arca",
    "afip",
    "argentina",
    "sdk",
    "typescript",
    "wsaa",
    "soap",
    "common"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiidv/arca-sdks.git",
    "directory": "packages/common"
  },
  "homepage": "https://arca-sdk.dev/common",
  "bugs": {
    "url": "https://github.com/ramiidv/arca-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0",
    "node-forge": "^1.3.0"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.0"
  }
}
