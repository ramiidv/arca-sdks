{
  "name": "@ramiidv/arca-sire",
  "version": "0.5.0",
  "description": "TypeScript SDK para el web service SIRE de ARCA (ex AFIP): emisión y anulación de certificados de retención electrónicos de IVA (C2005)",
  "author": "ramiidv",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only"
  },
  "keywords": [
    "arca",
    "afip",
    "sire",
    "c2005",
    "certificado-retencion",
    "retenciones",
    "iva",
    "argentina",
    "sdk",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiidv/arca-sdks.git",
    "directory": "packages/sire"
  },
  "homepage": "https://arca-sdk.dev/sire",
  "bugs": {
    "url": "https://github.com/ramiidv/arca-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@ramiidv/arca-common": "^0.7.0"
  }
}
