{
  "name": "@ramiidv/arca-fecred",
  "version": "0.3.0",
  "description": "TypeScript SDK para el web service WSFECRED de ARCA (ex AFIP) - Factura de Credito Electronica MiPyME",
  "author": "ramiidv",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:pkg": "publint --strict && attw --pack . --profile esm-only"
  },
  "keywords": [
    "arca",
    "afip",
    "wsfecred",
    "fce",
    "factura-credito-electronica",
    "mipyme",
    "argentina",
    "sdk",
    "typescript",
    "soap"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramiidv/arca-sdks.git",
    "directory": "packages/fecred"
  },
  "homepage": "https://arca-sdk.dev/fecred",
  "bugs": {
    "url": "https://github.com/ramiidv/arca-sdks/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@ramiidv/arca-common": "^0.4.0"
  }
}
